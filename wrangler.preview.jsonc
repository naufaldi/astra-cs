// Preview Worker only. Deploy with `npx wrangler deploy -c wrangler.preview.jsonc`.
// This file does not target monitor-pangan-support or its D1 database.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monitor-pangan-support-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/chat", "/mcp", "/handoff", "/credits", "/admin", "/admin/*"]
  },
  "vars": {
    "PRICE_SOURCE": "live"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astra-cs-preview",
      "database_id": "defa7c7a-0c44-4f55-b7a9-16f22b5eeacf",
      "migrations_dir": "migrations"
    }
  ]
}
