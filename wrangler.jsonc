{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monitor-pangan-support",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/chat", "/mcp", "/handoff", "/credits", "/admin", "/admin/*"]
  },
  "vars": {
    "PRICE_SOURCE": "live"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monitor-pangan-handoff",
      "database_id": "fc312fce-8abd-446a-9dfd-7cc2d0015e07",
      "migrations_dir": "migrations"
    }
  ]
}
